PORT=3001
HOST=0.0.0.0
# Required for cookies on an HTTPS deployment. Run behind a trusted TLS reverse proxy.
SECURE_COOKIES=false
# A real contact address is recommended for deployed Web Push.
VAPID_SUBJECT=mailto:hello@example.com
# Optional: directory on a persistent volume for SQLite and generated VAPID keys.
# DATA_DIR=./data
# Optional: enable server-side voice nudges and wake-up checks.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ElevenLabs base URL, useful for tests and proxies.
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
