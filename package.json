{
  "name": "owlert-habit-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "icons": "node scripts/generate-icons.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src server shared tests scripts public/manifest.webmanifest public/sw.js index.html vite.config.js package.json README.md",
    "format:check": "prettier --check src server shared tests scripts public/manifest.webmanifest public/sw.js index.html vite.config.js package.json README.md"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.8",
    "vite": "^7.1.0"
  }
}
